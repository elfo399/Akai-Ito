# Linux operator configuration. Copy OUTSIDE Git; chmod 600. No secret values here.
# Deploy directory must be exactly the directory used by Jenkins for .deploy.lock.
BACKUP_DEPLOY_DIR=/path/to/configured/deploy
COMPOSE_PROJECT_NAME=akai-ito
# Prepare this private directory only AFTER verifying the external filesystem mount.
BACKUP_TARGET_DIR=/path/to/mounted/device/akai-ito-vault
BACKUP_REQUIRE_MOUNT=true
BACKUP_MOUNT_POINT=/path/to/mounted/device
# Optional exact findmnt SOURCE, e.g. a device/UUID-resolved source or mounted NAS.
BACKUP_EXPECTED_SOURCE=
BACKUP_EXPECTED_VOLUME=
# State/restart journal must remain local, outside the target and public web roots.
BACKUP_STATE_DIR=/path/to/configured/deploy/.memory-vault
RESTIC_REPOSITORY=/path/to/mounted/device/akai-ito-vault/repository
RESTIC_PASSWORD_FILE=/path/to/private/restic-password
# Full cryptographic repository read; periodic restore test is configured separately.
BACKUP_VERIFY_READ_DATA=true
BACKUP_MIN_FREE_MB=1024
BACKUP_HEALTH_TIMEOUT=180
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Off until the operator reviews retention --dry-run; only Vault snapshots are managed.
BACKUP_AUTO_RETENTION=false
# Optional locally available compatible image for disaster recovery on a new machine.
BACKUP_APP_IMAGE=
BACKUP_KEEP_TEST_VOLUME=false
# Optional PRIVATE executable receiving event metadata via VAULT_* environment.
BACKUP_FAILURE_HOOK=
# Schedule: systemd timer OnCalendar, default 03:30 Europe/Rome; see docs.
# TESTS ONLY: permit a temporary directory without an external mount.
BACKUP_TEST_MODE=false
