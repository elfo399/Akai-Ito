[Unit]
Description=Akai Ito Memory Vault — isolated recovery drill
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=CHANGE_ME
WorkingDirectory=/opt/akai-ito
Environment=MEMORY_VAULT_CONFIG=/etc/akai-ito/backup.env
ExecStart=/bin/bash /opt/akai-ito/scripts/memory-vault.sh test-restore latest
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
TimeoutStopSec=240
KillMode=mixed
StandardOutput=journal
StandardError=journal
