[Unit]
Description=Recover an app interrupted during Memory Vault capture
Requires=docker.service
After=docker.service
Before=akai-memory-vault.service

[Service]
Type=oneshot
User=CHANGE_ME
WorkingDirectory=/opt/akai-ito
Environment=MEMORY_VAULT_CONFIG=/etc/akai-ito/backup.env
ExecStart=/bin/bash /opt/akai-ito/scripts/memory-vault.sh recover
UMask=0077
TimeoutStartSec=240
TimeoutStopSec=240
KillMode=mixed

[Install]
WantedBy=multi-user.target
