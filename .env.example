# Local development: http://localhost:5173 + COOKIE_SECURE=false.
# Production: the EXACT HTTPS URL of your existing reverse proxy, no trailing slash.
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
PORT=3000
# Relative to the repository root; Compose always overrides it to /app/data.
DATA_DIR=./data
# Enable only when the app is reachable exclusively through your trusted proxy.
TRUST_PROXY=false
MAX_UPLOAD_FILES=20
MAX_IMAGE_MB=15

# Configurazione cartografia (opzionale). Nessun servizio di geocoding.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
MAP_MAX_ZOOM=19
